# Railway also accepts DATABASE_URL. Standard postgresql:// values are supported.
POSTGRES_URL=postgresql+psycopg://user:password@ep-example.us-east-2.aws.neon.tech/sentinelai?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
OPENROUTER_API_KEY=
# Free OpenRouter router. A free OpenRouter API key is still required.
OPENROUTER_MODEL=openrouter/free
VITE_API_URL=http://localhost:8001/api/v1
VITE_WS_URL=ws://localhost:8001/api/v1/ws
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://localhost,capacitor://localhost
